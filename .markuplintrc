{
  "extends": [
    "markuplint:recommended-vue"
  ],
  "parser": {
    ".vue$": "@markuplint/vue-parser"
  },
  "specs": {
    ".vue$": "@markuplint/vue-spec"
  },
  "rules": {
    "require-attr": true,
    "require-accessible-name": false,
    "no-hardcodeed-id": false
  },
  "nodeRules": [
    {
      "selector": "img",
      "rules": {
        "require-attr": "alt"
      }
    }
  ]
}
